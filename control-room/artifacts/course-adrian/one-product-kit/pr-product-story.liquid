{% comment %}
  Project Rich / rato. — single-product story, draft module.
  Course references: 00:28–00:31; 00:32–00:34; 03:17; 03:21–03:32.
  Implementation choices (not course claims): approval flags, reduced motion,
  deferred model loader, and no checkout/analytics code.
  These flags only control this section, not other product routes or store access.
{% endcomment %}
{% liquid
  assign selected = section.settings.product
  if selected == blank
    assign selected = product
  endif
  assign show_section = false
  if request.design_mode
    assign show_section = true
  elsif section.settings.publication_approved and selected != blank
    assign show_section = true
  endif
  assign story_video = selected.media | where: 'media_type', 'video' | first
  assign story_model = selected.media | where: 'media_type', 'model' | first
  assign heading = section.settings.heading | default: selected.title
%}
{% if show_section %}
<pr-product-story id="PRStory-{{ section.id }}" class="pr-story" data-autoplay="{{ section.settings.autoplay }}">
  {% if request.design_mode %}
    <p class="pr-story__editor">Vista de edición · La aprobación de esta sección no activa ni protege el resto de la tienda.</p>
  {% endif %}
  {% if selected == blank %}
    <div class="pr-story__empty">
      <p class="pr-story__eyebrow">Un producto. Una propuesta.</p>
      <h2>Selecciona el producto del experimento.</h2>
      <p>Este módulo no crea productos, no inventa imágenes y no admite pedidos.</p>
    </div>
  {% else %}
    <div class="pr-story__hero">
      <div class="pr-story__copy">
        {% if section.settings.eyebrow != blank %}<p class="pr-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <{{ section.settings.heading_level }} class="pr-story__title">{{ heading | escape }}</{{ section.settings.heading_level }}>
        {% if section.settings.introduction != blank %}<div class="pr-story__intro">{{ section.settings.introduction }}</div>{% endif %}
        {% if section.settings.offer_verified %}
          <p class="pr-story__price">{% if selected.price_varies %}Desde {% endif %}{{ selected.price | money_with_currency }}</p>
          {% if section.settings.delivery_note != blank %}<p class="pr-story__delivery">{{ section.settings.delivery_note | escape }}</p>{% endif %}
        {% endif %}
        {% if section.settings.publication_approved and section.settings.offer_verified %}
          <a class="pr-story__cta" href="{{ selected.url | escape }}">Ver producto y condiciones <span aria-hidden="true">↗</span></a>
        {% else %}
          <p class="pr-story__pending">Oferta en preparación. Sin acceso de compra desde esta sección.</p>
        {% endif %}
      </div>
      <div class="pr-story__media">
        {% if section.settings.media_verified and selected.featured_media.preview_image != blank %}
          {{ selected.featured_media.preview_image | image_url: width: 1600 | image_tag: widths: '400, 720, 1000, 1600', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', class: 'pr-story__poster', alt: selected.title }}
        {% else %}
          <div class="pr-story__placeholder"><p>Fotografía del producto</p><small>Pendiente de verificar el modelo y los derechos de uso.</small></div>
        {% endif %}
        {% if section.settings.media_verified and story_video != blank %}
          <details class="pr-story__explore" data-video-panel>
            <summary>Ver el producto en movimiento</summary>
            {{ story_video | video_tag: controls: true, muted: true, loop: true, playsinline: true, preload: 'none', image_size: '1000x' }}
            {% if section.settings.video_description != blank %}<p>{{ section.settings.video_description | escape }}</p>{% endif %}
          </details>
        {% endif %}
        {% if section.settings.media_verified and story_model != blank %}
          <div class="pr-story__model">
            <button type="button" class="pr-story__secondary" data-load-model hidden aria-expanded="false" aria-controls="PRModel-{{ section.id }}">Explorar el objeto en 3D</button>
            <div id="PRModel-{{ section.id }}" data-model-host></div>
            <p data-model-status class="pr-story__status" role="status" aria-live="polite"></p>
            <template data-model-template>{{ story_model | model_viewer_tag: image_size: '1000x', loading: 'lazy', reveal: 'auto', interaction-prompt: 'none', camera-controls: true }}</template>
            <noscript><p>El modelo interactivo requiere JavaScript. La fotografía y los detalles siguen disponibles.</p></noscript>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="pr-story__content">
      {% for block in section.blocks %}
        {% if block.settings.verified %}
          {% case block.type %}
            {% when 'benefit' %}
              <article class="pr-story__card" {{ block.shopify_attributes }}>
                <p class="pr-story__eyebrow">Qué aporta</p><h3>{{ block.settings.title | escape }}</h3><div>{{ block.settings.text }}</div>
              </article>
            {% when 'step' %}
              <article class="pr-story__card" {{ block.shopify_attributes }}>
                <p class="pr-story__eyebrow">Cómo se usa</p><h3>{{ block.settings.title | escape }}</h3><div>{{ block.settings.text }}</div>
              </article>
            {% when 'faq' %}
              <details class="pr-story__faq" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary><div>{{ block.settings.text }}</div></details>
          {% endcase %}
        {% elsif request.design_mode %}
          <p class="pr-story__editor" {{ block.shopify_attributes }}>Bloque pendiente de revisar: {{ block.settings.title | default: block.type | escape }}.</p>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</pr-product-story>
{% endif %}

{% stylesheet %}
.pr-story{display:block;background:#f6f3ee;color:#282b26;padding:clamp(24px,5vw,80px);font-family:inherit;--pr-line:#d4d0c6;--pr-ink:#282b26;--pr-accent:#355441}
.pr-story,.pr-story *{box-sizing:border-box}.pr-story [hidden]{display:none!important}
.pr-story__hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(24px,6vw,90px);align-items:center;max-width:1360px;margin:auto}
.pr-story__copy,.pr-story__media{min-width:0}.pr-story__eyebrow{font-size:12px;line-height:1.5;letter-spacing:.16em;text-transform:uppercase;margin:0 0 18px}
.pr-story__title{font-family:var(--font-heading-family,Georgia,serif);font-weight:400;font-size:clamp(34px,4.5vw,68px);line-height:1.06;letter-spacing:-.035em;margin:0 0 24px;overflow-wrap:anywhere}
.pr-story__intro{font-size:18px;line-height:1.65;max-width:44ch}.pr-story__price{font-size:25px;margin:28px 0 8px}.pr-story__delivery,.pr-story__pending{font-size:14px;line-height:1.6}
.pr-story__cta,.pr-story__secondary{display:inline-flex;align-items:center;justify-content:center;gap:32px;min-height:48px;border-radius:3px;padding:14px 22px;font:inherit;line-height:1.4;text-decoration:none;cursor:pointer}
.pr-story__cta{color:#fff;background:var(--pr-accent);margin-top:16px}.pr-story__secondary{background:transparent;border:1px solid var(--pr-ink);color:var(--pr-ink);width:100%;margin-top:18px}
.pr-story__cta:focus-visible,.pr-story__secondary:focus-visible,.pr-story summary:focus-visible{outline:3px solid var(--pr-accent);outline-offset:4px}
.pr-story__poster{display:block;width:100%;height:auto;max-height:640px;object-fit:contain;background:#eeeae2;border-radius:5px}
.pr-story__placeholder{min-height:300px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;border:1px dashed var(--pr-line);padding:32px;border-radius:5px}.pr-story__placeholder small{max-width:32ch;line-height:1.6}
.pr-story__explore{border-bottom:1px solid var(--pr-line);margin-top:12px}.pr-story summary{cursor:pointer;min-height:48px;padding:17px 0;font-size:16px;line-height:1.5}.pr-story__explore video{display:block;width:100%;max-height:640px;background:#e9e6df}.pr-story__explore p{font-size:14px;line-height:1.6}
.pr-story [data-model-host] model-viewer{display:block;width:100%;height:clamp(280px,40vw,550px);background:#eeeae2}.pr-story__status{font-size:13px;line-height:1.5}
.pr-story__content{max-width:1360px;margin:56px auto 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.pr-story__card{border-top:1px solid var(--pr-line);padding:24px 0}.pr-story h3{font-size:24px;font-weight:500;margin:0 0 12px}.pr-story__card div,.pr-story__faq div{line-height:1.7;font-size:16px;overflow-wrap:anywhere}
.pr-story__faq{grid-column:1/-1;border-top:1px solid var(--pr-line)}.pr-story__faq div{max-width:80ch;padding-bottom:20px}.pr-story__empty{max-width:700px;padding:40px 0}.pr-story__editor{border-left:3px solid #706144;padding:8px 16px;font-size:13px;line-height:1.5;background:#efe9dd}
@media(max-width:899px){.pr-story__hero{grid-template-columns:1fr}.pr-story__content{grid-template-columns:1fr;margin-top:32px}.pr-story__cta{width:100%;gap:18px}.pr-story__intro{font-size:16px}.pr-story__poster{max-height:470px}}
@media(prefers-reduced-motion:reduce){.pr-story,.pr-story *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('pr-product-story')) {
  customElements.define('pr-product-story', class extends HTMLElement {
    connectedCallback() {
      if (this.abort || this.initRequested) return;
      this.initRequested = requestAnimationFrame(() => {
        this.initRequested = null;
        if (this.isConnected) this.initialize();
      });
    }
    initialize() {
      if (this.abort) return;
      this.abort = new AbortController();
      const options = { signal: this.abort.signal };
      this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.video = this.querySelector('video');
      this.panel = this.querySelector('[data-video-panel]');
      this.visible = false;
      this.autoEligible = this.dataset.autoplay === 'true';
      this.pausePending = false;
      this.modelState = 'idle';
      this.modelButton = this.querySelector('[data-load-model]');
      if (this.modelButton) {
        this.modelButton.hidden = false;
        this.modelButton.addEventListener('click', () => this.loadModel(), options);
      }
      if (this.video && this.panel) {
        this.video.addEventListener('pause', () => {
          if (!this.pausePending) this.autoEligible = false;
          this.pausePending = false;
        }, options);
        this.panel.addEventListener('toggle', () => this.syncVideo(), options);
        document.addEventListener('visibilitychange', () => this.syncVideo(), options);
        this.motion.addEventListener('change', () => this.syncVideo(), options);
        if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver((entries) => {
            this.visible = entries[0].isIntersecting;
            this.syncVideo();
          }, { threshold: 0.1 });
          this.observer.observe(this.panel);
        }
        // Without IntersectionObserver we deliberately keep click-to-play.
      }
    }
    stopVideo() {
      if (this.video && !this.video.paused) {
        this.pausePending = true;
        this.video.pause();
      }
    }
    syncVideo() {
      if (!this.video) return;
      if (document.hidden || !this.panel.open || !this.visible || this.motion.matches) {
        this.stopVideo();
        return;
      }
      if (this.autoEligible && this.video.paused) {
        const result = this.video.play();
        if (result && result.catch) result.catch(() => { this.autoEligible = false; });
      }
    }
    loadModel() {
      if (this.modelState === 'loading' || this.modelState === 'ready') return;
      const template = this.querySelector('[data-model-template]');
      const host = this.querySelector('[data-model-host]');
      const status = this.querySelector('[data-model-status]');
      if (!template || !host || !status) return;
      const fail = () => {
        this.modelState = 'error';
        this.modelButton.hidden = false;
        this.modelButton.disabled = false;
        this.modelButton.textContent = 'Reintentar el modelo 3D';
        this.modelButton.setAttribute('aria-expanded', 'false');
        status.textContent = 'No se ha podido cargar el 3D. La fotografía y los detalles siguen disponibles.';
        if (this.viewer && this.viewer.destroy) this.viewer.destroy();
        this.viewer = null;
        host.replaceChildren();
      };
      if (!window.Shopify || typeof window.Shopify.loadFeatures !== 'function') { fail(); return; }
      this.modelState = 'loading';
      this.modelButton.disabled = true;
      status.textContent = 'Cargando el modelo del producto…';
      const attempt = Symbol('model-load');
      this.modelAttempt = attempt;
      this.modelTimeout = setTimeout(() => {
        if (this.modelAttempt === attempt && this.modelState === 'loading') { this.modelAttempt = null; fail(); }
      }, 10000);
      const loaded = (error) => {
        if (!this.isConnected || this.modelAttempt !== attempt) return;
        clearTimeout(this.modelTimeout);
        if (error || typeof window.Shopify.ModelViewerUI !== 'function') { fail(); return; }
        try {
          host.append(template.content.cloneNode(true));
          const model = host.querySelector('model-viewer');
          if (!model) throw new Error('Missing model');
          model.removeAttribute('auto-rotate');
          model.removeAttribute('autoplay');
          model.addEventListener('error', fail, { signal: this.abort.signal, once: true });
          this.viewer = new window.Shopify.ModelViewerUI(model);
          this.modelState = 'ready';
          this.modelButton.disabled = false;
          this.modelButton.hidden = true;
          this.modelButton.setAttribute('aria-expanded', 'true');
          status.textContent = 'Modelo interactivo. Arrastra para girarlo o utiliza sus controles.';
          model.setAttribute('tabindex', '0');
          model.focus();
        } catch (_) { fail(); }
      };
      try { window.Shopify.loadFeatures([{name: 'model-viewer-ui', version: '1.0', onLoad: loaded}]); }
      catch (_) { clearTimeout(this.modelTimeout); fail(); }
    }
    disconnectedCallback() {
      cancelAnimationFrame(this.initRequested);
      this.initRequested = null;
      this.stopVideo();
      this.abort?.abort();
      this.observer?.disconnect();
      clearTimeout(this.modelTimeout);
      this.modelAttempt = null;
      if (this.viewer && this.viewer.destroy) this.viewer.destroy();
      this.querySelector('[data-model-host]')?.replaceChildren();
      this.abort = null;
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "PR · Un producto",
  "tag": "section",
  "limit": 1,
  "enabled_on": {"templates": ["index", "page", "product"]},
  "settings": [
    {"type": "product", "id": "product", "label": "Producto del experimento"},
    {"type": "select", "id": "heading_level", "label": "Nivel del título", "options": [{"value": "h1", "label": "Título principal"}, {"value": "h2", "label": "Título de sección"}], "default": "h2"},
    {"type": "text", "id": "eyebrow", "label": "Texto breve superior"},
    {"type": "text", "id": "heading", "label": "Título (vacío: nombre del producto)"},
    {"type": "richtext", "id": "introduction", "label": "Problema y solución verificable"},
    {"type": "text", "id": "delivery_note", "label": "Condiciones de entrega confirmadas"},
    {"type": "textarea", "id": "video_description", "label": "Explicación textual del vídeo"},
    {"type": "checkbox", "id": "media_verified", "label": "Modelo y derechos de los activos revisados", "default": false},
    {"type": "checkbox", "id": "offer_verified", "label": "Precio y condiciones revisados", "default": false},
    {"type": "checkbox", "id": "autoplay", "label": "Reproducir vídeo al abrir (sin sonido)", "default": false},
    {"type": "checkbox", "id": "publication_approved", "label": "Publicación de esta sección aprobada", "default": false},
    {"type": "paragraph", "content": "Los controles son recordatorios humanos, no validaciones automáticas. No protegen otras páginas ni desactivan el checkout de Shopify. Trabajar en un tema no publicado hasta autorización."}
  ],
  "blocks": [
    {"type": "benefit", "name": "Beneficio", "settings": [{"type": "text", "id": "title", "label": "Título"}, {"type": "richtext", "id": "text", "label": "Explicación respaldada"}, {"type": "checkbox", "id": "verified", "label": "Texto revisado", "default": false}]},
    {"type": "step", "name": "Paso de uso", "settings": [{"type": "text", "id": "title", "label": "Paso y título"}, {"type": "richtext", "id": "text", "label": "Instrucciones del producto"}, {"type": "checkbox", "id": "verified", "label": "Texto revisado", "default": false}]},
    {"type": "faq", "name": "Pregunta frecuente", "settings": [{"type": "text", "id": "title", "label": "Pregunta"}, {"type": "richtext", "id": "text", "label": "Respuesta verificada"}, {"type": "checkbox", "id": "verified", "label": "Texto revisado", "default": false}]}
  ],
  "max_blocks": 16,
  "presets": [{"name": "PR · Un producto", "blocks": [{"type": "benefit"}, {"type": "step"}, {"type": "faq"}]}]
}
{% endschema %}
